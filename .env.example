# Copy to .env and fill in your real keys.
# .env is gitignored; .env.example is the tracked template.
# docker-compose.yml reads these via ${VAR} interpolation.
SIBYL_CLOUD_API_KEY=your-provider-key-here
# cloud base defaults to https://api.x.ai/v1, the local pair points at a llama-server on the host
#SIBYL_CLOUD_API_BASE=https://api.x.ai/v1
#SIBYL_CLOUD_MODELS=grok-4-1-fast-reasoning
#SIBYL_LOCAL_API_BASE=http://host.docker.internal:18200/v1
#SIBYL_LOCAL_MODELS=Qwen3.5-9B-Q4_K_M
#SIBYL_THINKING=1
GEOLANG_OUTPUTS_RETENTION_DAYS=30
