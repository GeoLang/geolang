        },
        "visible": {
          "type": "boolean",
          "description": "true shows the layer, false hides it"
        }
      },
      "required": [
        "layer",
        "visible"
      ]
    },
    "reads": false,
    "destructive": false
  },
  {
    "name": "layers.set_opacity",
