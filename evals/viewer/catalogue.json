[
  {
    "name": "camera.fly_to",
    "description": "Move the camera to a longitude and latitude",
    "parameters": {
      "type": "object",
      "properties": {
        "lon": {
          "type": "number",
          "description": "longitude in degrees"
        },
        "lat": {
          "type": "number",
          "description": "latitude in degrees"
        },
        "height": {
          "type": "number",
          "description": "camera height in metres"
        },
        "heading": {
          "type": "number",
          "description": "camera heading in degrees"
        },
        "pitch": {
          "type": "number",
          "description": "camera pitch in degrees"
        }
      },
      "required": [
        "lon",
        "lat"
      ]
    },
    "reads": false,
    "destructive": false
  },
  {
    "name": "renderer.set",
    "description": "Switch between the 3D globe and the 2D map",
    "parameters": {
      "type": "object",
      "properties": {
        "renderer": {
          "type": "string",
          "description": "which renderer draws the map",
          "enum": [
            "cesium",
            "maplibre"
          ]
        },
        "tab": {
          "type": "string",
          "description": "which tab to show",
          "enum": [
            "globe",
            "map"
          ]
        }
      },
      "required": [
        "renderer"
      ]
    },
    "reads": false,
    "destructive": false
  },
  {
    "name": "basemap.set",
