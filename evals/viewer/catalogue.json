    "parameters": {
      "type": "object",
      "properties": {
        "basemap": {
          "type": "string",
          "description": "which basemap to draw",
          "enum": [
            "osm",
            "satellite",
            "topo",
            "dark",
            "liberty",
            "bright",
            "positron",
            "selfhosted"
          ]
        }
      },
      "required": [
        "basemap"
      ]
    },
    "reads": false,
    "destructive": false
  },
  {
