  {
    "name": "scenario.compare",
    "description": "Compare two branches of a dataset, distance in metres",
    "parameters": {
      "type": "object",
      "properties": {
        "dataset": {
          "type": "string",
          "description": "id or name from the viewer state"
        },
        "base_branch": {
          "type": "string",
          "description": "branch to compare against"
        },
        "scenario_branch": {
          "type": "string",
          "description": "branch holding the change"
        },
        "distance": {
          "type": "number",
          "description": "how far apart two features may be and still pair, in metres"
        },
        "base_at": {
          "type": "string",
          "description": "ISO 8601 moment for the base branch"
        },
        "scenario_at": {
          "type": "string",
          "description": "ISO 8601 moment for the scenario branch"
        }
      },
      "required": [
        "dataset",
        "base_branch",
        "scenario_branch"
      ]
    },
    "reads": false,
    "destructive": false
  },
